<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script:module PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "module.dtd">
<script:module xmlns:script="http://openoffice.org/2000/script" script:name="Module1" script:language="StarBasic">Sub UpdateAndExport(sIn As String, sPdf As String, sDocx As String)
  Dim a(0) As New com.sun.star.beans.PropertyValue
  a(0).Name = &quot;Hidden&quot; : a(0).Value = True
  oDoc = StarDesktop.loadComponentFromURL(ConvertToURL(sIn), &quot;_blank&quot;, 0, a())
  Dim k As Integer, i As Integer
  For k = 1 To 3
    oIdx = oDoc.getDocumentIndexes()
    For i = 0 To oIdx.getCount() - 1
      oIdx.getByIndex(i).update()
    Next i
    oDoc.getTextFields().refresh()
    oDoc.refresh()
  Next k
  Dim p(0) As New com.sun.star.beans.PropertyValue
  p(0).Name = &quot;FilterName&quot;
  p(0).Value = &quot;writer_pdf_Export&quot;
  oDoc.storeToURL(ConvertToURL(sPdf), p())
  If sDocx &lt;&gt; &quot;&quot; Then
    p(0).Value = &quot;MS Word 2007 XML&quot;
    oDoc.storeToURL(ConvertToURL(sDocx), p())
  End If
  oDoc.close(True)
End Sub
</script:module>
